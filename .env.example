# MISHUTEC - Plantilla de Variables de Entorno
DB_SERVER=DESKTOP-QV4VK5K\SQLEXPRESS
DB_NAME=MishutecT2
DB_AUTH_MODE=windows
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes

# Para Azure SQL, cambia DB_AUTH_MODE a sql y configura estas variables.
# Usa el servidor tcp:<servidor>.database.windows.net,1433 y un usuario SQL
# de aplicación con permisos limitados; nunca publiques los valores reales.
# DB_AUTH_MODE=sql
# DB_SERVER=tu-servidor.database.windows.net
# DB_NAME=MishutecProduccion
# DB_USER=usuario_aplicacion
# DB_PASSWORD=
# DB_TRUST_SERVER_CERTIFICATE=no

# Autenticación Administrativa Local (Fase 3B)
# Generar hash mediante: npx tsx scripts/generate-admin-hash.ts "SuPassword"
# El administrador inicial se configura en el servicio de alojamiento; desde
# la pantalla /usuarios podrá crear cuentas individuales para el equipo.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=salt_hex:derived_key_hex
AUTH_SESSION_SECRET=minimo_32_caracteres_aleatorios_hex

# Protección de Entorno Académico
ALLOW_ACADEMIC_MUTATIONS=false
